# 환경변수 전 항목 (구현명세서 §2.4). **실값을 여기 넣지 않는다** — 이 파일은 커밋된다.
# 로컬·CI는 DEV_MODE=true면 실키 없이 돈다 (fake LLM + 로컬 SQLite — §2.0·§6.7).

# --- DB (§2.4) ---
# 배포: Supabase Postgres(서울). DEV_MODE=true이고 값이 비면 로컬 SQLite로 수렴한다.
DATABASE_URL=
# 신 계보: proto_v1(시연·QA) → main_v1(본실험). 구 study2_pipeline의 pilot_* 스키마를 재사용하지 않는다.
DB_SCHEMA=proto_v1
STUDY_VERSION=proto_v1

# --- LLM (§2.2) — DEV_MODE=true면 미사용 ---
OPENROUTER_API_KEY=
MAIN_MODEL_ID=anthropic/claude-opus-4.8
VALIDATOR_MODEL_ID=openai/gpt-5.4
LLM_CONCURRENCY=8
AI2_TIMEOUT_MS=90000
CHECKER_TIMEOUT_MS=45000
AI2_DEADLINE_SECONDS=45

# --- 연구자 콘솔 (§2.7 HTTP Basic auth) ---
ADMIN_USER=
ADMIN_PASS=

# --- 암호화 (§2.9) ---
# 생성: python -c "from app.security.fernet import generate_key; print(generate_key())"
# ⚠ 수집 시작 후 변경 금지 — 바꾸면 🔒 필드(User1·AI2·sidecar·flag 사유)를 복호화할 수 없다.
FERNET_KEY=

# --- 운영 알림 (§2.8) ---
DISCORD_WEBHOOK_URL=

# --- 팀 시연·CI 구성 (§0.5) ---
DEV_MODE=true
